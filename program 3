Aim
To implement a Matrix class using operator overloading for addition (+), multiplication (*),
element access ([]), and output (<<), and validate the operations using simple unit tests.
Algorithm
1. Start the program.
2. Define a Matrix class with matrix elements stored in a two-dimensional array.
3. Initialize the matrix using a constructor.
4. Overload the + operator to add two matrices.
5. Overload the * operator to multiply two matrices.
6. Overload the [] operator to access matrix rows.
7. Overload the << operator to display the matrix.
8. Create matrices and perform addition and multiplication.
9. Validate the results using unit tests.
10. Display the results and end the program.
Program
#include <iostream>
#include <cassert>
using namespace std;
class Matrix
{
private:
int data[2][2];
public:
Matrix(int a = 0, int b = 0, int c = 0, int d = 0)

{
data[0][0] = a;
data[0][1] = b;
data[1][0] = c;
data[1][1] = d;
}
// Operator +
Matrix operator+(const Matrix &m)
{
Matrix result;
for (int i = 0; i < 2; i++)
for (int j = 0; j < 2; j++)
result.data[i][j] = data[i][j] + m.data[i][j];
return result;
}
// Operator *
Matrix operator*(const Matrix &m)
{
Matrix result;
for (int i = 0; i < 2; i++)
{
for (int j = 0; j < 2; j++)
{
result.data[i][j] = 0;

for (int k = 0; k < 2; k++)
result.data[i][j] += data[i][k] * m.data[k][j];

}
}
return result;
}
// Operator []
int* operator[](int index)
{
return data[index];
}

// Operator <<
friend ostream& operator<<(ostream &out, const Matrix &m)
{
for (int i = 0; i < 2; i++)
{
for (int j = 0; j < 2; j++)
out << m.data[i][j] << " ";

out << endl;
}
return out;
}
};
int main()
{
Matrix A(1, 2, 3, 4);
Matrix B(5, 6, 7, 8);

Matrix sum = A + B;
Matrix product = A * B;
// Unit Tests
assert(sum[0][0] == 6);
assert(sum[1][1] == 12);
assert(product[0][0] == 19);
assert(product[0][1] == 22);
assert(product[1][0] == 43);
assert(product[1][1] == 50);
cout << "Matrix A:" << endl;
cout << A;
cout << "Matrix B:" << endl;
cout << B;

cout << "Addition of Matrices:" << endl;
cout << sum;
cout << "Multiplication of Matrices:" << endl;
cout << product;
cout << "All unit tests passed successfully." << endl;
return 0;
}

Inference
The program demonstrates operator overloading by allowing matrix objects to use operators such
as +, *, [], and <<. The unit tests verify that matrix addition and multiplication produce the
expected results.

Result
Thus, a Matrix class was successfully implemented using operator overloading, and its
operations were validated successfully using unit tests.
